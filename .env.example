# ==============================================================================
# Trust Care Electronics - Environment Variables Template
# ==============================================================================
# 
# 1. LOCAL DEVELOPMENT:
#    Copy this file to `.env` in the project root:
#    cp .env.example .env
#
# 2. VERCEL HOSTING & DEPLOYMENT:
#    Set these variables in the Vercel Dashboard:
#    Project Dashboard -> Settings -> Environment Variables -> Add Variable
#    Ensure they are applied to Production, Preview, and Development.
# ==============================================================================

# Contact Phone / WhatsApp Number (International format with country code, e.g. +919884087878)
# Used for click-to-call (tel:) and instant WhatsApp inquiries
CONTACT_NUMBER="+919884087878"

# Formatted Display Phone Number
# Displayed visually across the top bar, contact section, and sticky call buttons
DISPLAY_CONTACT_NUMBER="+91 9884087878"

# Official Business Support Email Address
# Used for customer support mailto: links and footer info
EMAIL_ADDRESS="trustcareelectronics@gmail.com"

# Google Maps Showroom Location URL
# Opens Google Maps direction link to Trust Care Electronics store in Madambakkam, Chennai
MAP_LOCATION_URL="https://maps.app.goo.gl/U5BKf7q1mpoMP46T9"
